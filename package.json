{
  "name": "@kubohiroya/turbowarp-document-source",
  "version": "0.2.0",
  "description": "Shared document source, provider, adapter and registry contracts for TurboWarp extensions.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "README.ja.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "test": "node --test test/*.test.ts",
    "check:dist": "node scripts/check-dist.ts",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "check": "npm run typecheck && npm test && npm run check:dist && npm run pack:check"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MPL-2.0",
  "author": {
    "name": "Hiroya Kubo",
    "email": "hiroya@cuc.ac.jp",
    "url": "https://github.com/kubohiroya"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kubohiroya/turbowarp-document-source.git"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
