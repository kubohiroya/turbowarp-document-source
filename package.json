{
  "name": "@kubohiroya/turbowarp-document-source",
  "version": "0.1.0-rc.0",
  "description": "Document sources from SB3 files, HTTPS URLs, YAML blocks and schema-specific blocks.",
  "type": "module",
  "sideEffects": false,
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    },
    "./package.json": "./package.json",
    "./assets/yaml-file.svg": "./assets/yaml-file.svg",
    "./yaml-blocks": {
      "types": "./src/yaml-blocks.d.ts",
      "import": "./src/yaml-blocks.js"
    },
    "./source-view": {
      "types": "./src/yaml-source-view.d.ts",
      "import": "./src/yaml-source-view.js"
    },
    "./runtime": {
      "types": "./src/runtime.d.ts",
      "import": "./src/runtime.js"
    },
    "./project-views": {
      "types": "./src/project-views.d.ts",
      "import": "./src/project-views.js"
    },
    "./view-metadata": {
      "types": "./src/view-metadata.d.ts",
      "import": "./src/view-metadata.js"
    },
    "./document-views": {
      "types": "./src/document-views.d.ts",
      "import": "./src/document-views.js"
    },
    "./assets/yaml-block.svg": "./assets/yaml-block.svg",
    "./sources": {
      "types": "./src/document-source.d.ts",
      "import": "./sources.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "src",
    "assets",
    "README.md",
    "LICENSE",
    "sources.js"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "pack:check": "npm pack --dry-run --ignore-scripts"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MPL-2.0",
  "author": {
    "name": "Hiroya Kubo",
    "email": "hiroya@cuc.ac.jp",
    "url": "https://github.com/kubohiroya"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kubohiroya/turbowarp-document-source.git"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "dependencies": {
    "@kubohiroya/turbowarp-document-data": "0.5.0-rc.1",
    "@kubohiroya/turbowarp-yaml-json": "0.8.0-rc.0"
  },
  "devDependencies": {
    "@turbowarp/jszip": "3.12.0"
  }
}
