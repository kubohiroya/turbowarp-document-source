{
  "name": "@kubohiroya/turbowarp-document-source",
  "version": "0.1.0-rc.0",
  "description": "Document sources from SB3 files, HTTPS URLs, YAML blocks and schema-specific blocks.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./assets/yaml-file.svg": "./assets/yaml-file.svg",
    "./yaml-blocks": {
      "types": "./dist/yaml-blocks.d.ts",
      "import": "./dist/yaml-blocks.js"
    },
    "./source-view": {
      "types": "./dist/yaml-source-view.d.ts",
      "import": "./dist/yaml-source-view.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./project-views": {
      "types": "./dist/project-views.d.ts",
      "import": "./dist/project-views.js"
    },
    "./view-metadata": {
      "types": "./dist/view-metadata.d.ts",
      "import": "./dist/view-metadata.js"
    },
    "./document-views": {
      "types": "./dist/document-views.d.ts",
      "import": "./dist/document-views.js"
    },
    "./assets/yaml-block.svg": "./assets/yaml-block.svg",
    "./sources": {
      "types": "./dist/sources.d.ts",
      "import": "./dist/sources.js"
    }
  },
  "files": [
    "dist",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "test": "node --test test/*.test.ts",
    "check:dist": "node scripts/check-dist.ts",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "check": "npm run typecheck && npm test && npm run check:dist && npm run pack:check"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MPL-2.0",
  "author": {
    "name": "Hiroya Kubo",
    "email": "hiroya@cuc.ac.jp",
    "url": "https://github.com/kubohiroya"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kubohiroya/turbowarp-document-source.git"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "dependencies": {
    "@kubohiroya/turbowarp-document-data": "0.5.0-rc.1",
    "@kubohiroya/turbowarp-yaml-json": "0.8.0-rc.0"
  },
  "devDependencies": {
    "@turbowarp/jszip": "3.12.0",
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
