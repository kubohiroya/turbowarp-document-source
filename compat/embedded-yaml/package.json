{
  "name": "@kubohiroya/turbowarp-embedded-yaml",
  "version": "0.2.0-rc.0",
  "description": "Compatibility facade for turbowarp-document-source.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./assets/yaml-file.svg": "./assets/yaml-file.svg",
    "./yaml-blocks": {
      "types": "./dist/yaml-blocks.d.ts",
      "import": "./dist/yaml-blocks.js"
    },
    "./source-view": {
      "types": "./dist/yaml-source-view.d.ts",
      "import": "./dist/yaml-source-view.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./project-views": {
      "types": "./dist/project-views.d.ts",
      "import": "./dist/project-views.js"
    },
    "./view-metadata": {
      "types": "./dist/view-metadata.d.ts",
      "import": "./dist/view-metadata.js"
    },
    "./document-views": {
      "types": "./dist/document-views.d.ts",
      "import": "./dist/document-views.js"
    },
    "./assets/yaml-block.svg": "./assets/yaml-block.svg"
  },
  "files": [
    "dist",
    "assets",
    "README.md",
    "README.ja.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "license": "MPL-2.0",
  "author": {
    "name": "Hiroya Kubo",
    "email": "hiroya@cuc.ac.jp",
    "url": "https://github.com/kubohiroya"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kubohiroya/turbowarp-document-source.git"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "dependencies": {
    "@kubohiroya/turbowarp-document-data": "0.6.0-rc.0",
    "@kubohiroya/turbowarp-yaml-json": "0.9.0-rc.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "test": "node --test test/*.test.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
